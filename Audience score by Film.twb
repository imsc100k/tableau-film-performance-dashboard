        <rows>[Sample - Superstore].[Multiple Values]</rows>
        <cols>([Sample - Superstore].[none:Category:nk] / ([Sample - Superstore].[tyr:Order Date:ok] / [Sample - Superstore].[:Measure Names]))</cols>
